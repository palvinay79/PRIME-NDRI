# NDRI PRIME - Apache Configuration for cPanel
<IfModule mod_rewrite.c>
    RewriteEngine On
    # If installed in a subdirectory (e.g. /demo/pme/), leave RewriteBase commented out 
    # (Apache will automatically detect the current folder) or set it explicitly:
    # RewriteBase /demo/pme/

    # Prevent direct access to sensitive folders and file types
    RewriteRule ^data/ - [F,L]
    RewriteRule ^config/ - [F,L]
    RewriteRule \.(sql|env|json|ts|lock)$ - [F,L]

    # Clean URL support: If file.php exists, rewrite /path to /path.php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+)$ $1.php [L,QSA]
</IfModule>

# Protect sensitive files
<FilesMatch "^\.|\.(sql|sqlite|db|log|sh|env|json|ts|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Options
Options -Indexes
DirectoryIndex index.php index.html
